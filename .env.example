# GCP / Vertex AI
GOOGLE_CLOUD_PROJECT=csf-assessor-hackathon
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Storage
GCS_RAW_BUCKET=csf-assessor-hackathon-raw-docs
GCS_ARTIFACTS_BUCKET=csf-assessor-hackathon-artifacts

# Models
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=text-embedding-004

# Qdrant (local Docker default; swap for Qdrant Cloud URL in prod)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=csf_chunks

# Agent Gateway policy — required X-API-Key header on every route except
# /health, plus a per-key request budget. Leave GATEWAY_API_KEY blank for
# open local dev (rate limiting still applies); set a real value before
# deploying anywhere reachable by anyone but you.
GATEWAY_API_KEY=
GATEWAY_RATE_LIMIT_PER_MINUTE=2000

# Fortified — PII / threat screening at every LLM boundary.
#   PII_SCRUB_ENABLED: deterministic regex de-identification of PII *values*
#     (email/SSN/card/phone/IP -> [EMAIL] etc.) before any prompt reaches Gemini.
#   MODEL_ARMOR_*: managed Google Model Armor threat gate (prompt-injection /
#     jailbreak / malicious-URL / RAI screening + PII detection for the audit
#     trail). Leave MODEL_ARMOR_ENABLED blank/false for local dev (no API/creds
#     needed — it no-ops); set true in the deployed env. The SA needs
#     roles/modelarmor.user (granted in infra/deploy_gateway.sh).
PII_SCRUB_ENABLED=true
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_TEMPLATE_ID=my-test-template
# Hard-block a run on a confirmed injection/jailbreak (default false = log + proceed).
MODEL_ARMOR_BLOCK_ON_INJECTION=false

# --- Agent Runtime (GEAP) -----------------------------------------------------
# Which host executes an assessment. "native" routes it to the Coordinator
# deployed on Vertex AI Agent Engine, which is what the live demo runs.
# "inprocess" runs the same run_assessment() inside the gateway container and is
# the fallback. Switching is an env flip -- no code change, no rebuild.
COORDINATOR_MODE=native
REASONING_ENGINE_RESOURCE=projects/<PROJECT_NUMBER>/locations/us-central1/reasoningEngines/<ENGINE_ID>
# Agent Engine resources are regional. Deliberately NOT google_cloud_location,
# which is "global" so Gemini 3.x resolves -- the two are independent.
AGENT_ENGINE_LOCATION=us-central1

# --- Agent Registry (GEAP) ----------------------------------------------------
# GET /agents merges the native catalogue with Firestore metadata and degrades to
# Firestore-only if this is slow or unreachable, so a preview API can never hang
# a judge-facing route. Regional on purpose: manual registration is barred in the
# `us`/`eu` multi-regions, so this is NOT where the Model Armor template lives.
AGENT_REGISTRY_ENABLED=true
AGENT_REGISTRY_LOCATION=us-central1
AGENT_REGISTRY_TIMEOUT_SECONDS=4.0

# --- Which service is this? ---------------------------------------------------
# Set per deployment (gateway | worker | ui). Only the worker records the Agent
# Registry `iam_identity` field: all three containers import the specialist
# agents, so without this the field would report whichever started last rather
# than the identity that actually executes scoring.
CSF_SERVICE_ROLE=gateway

# --- Model fallback -----------------------------------------------------------
# Used only when the primary returns 429 after the retry layer is exhausted.
GEMINI_PRO_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_FLASH_FALLBACK_MODEL=gemini-3.7-flash

# --- Storage / ingest tuning (defaults are fine) -------------------------------
FIRESTORE_DATABASE=(default)
EMBEDDING_DIM=768
MAX_UPLOAD_BYTES=20971520
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
CHUNK_MAX_TOKENS=1200

# --- UI -----------------------------------------------------------------------
# Where the Streamlit app finds the gateway. Local default is http://localhost:8090.
GATEWAY_URL=https://<your-gateway>.run.app
